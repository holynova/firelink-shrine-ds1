{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firelink-shrine-ds1",
  "account_id": "ef7863c4de93e71c3496f940c8ab4865",
  "compatibility_date": "2026-10-17",
  "workers_dev": false,
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "xiaosang.cc/firelink-shrine-ds1/*",
      "zone_id": "a9ae8ed6c9a473e6c79daa58b29e8b12"
    },
    {
      "pattern": "xiaosang.cc/firelink-shrine-ds1",
      "zone_id": "a9ae8ed6c9a473e6c79daa58b29e8b12"
    }
  ]
}
